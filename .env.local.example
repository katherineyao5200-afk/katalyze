# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Supabase project settings -> API. The service role key bypasses row-level
# security and must never be exposed to the browser — it's only read
# server-side, inside app/api/waitlist/route.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by app/sitemap.ts. Set once a production domain is confirmed
# (see docs/PRD.md §14); defaults to localhost until then.
NEXT_PUBLIC_SITE_URL=
